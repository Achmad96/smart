generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("general")
  fields      Json     // Array of field definitions [{name, label, type, required, placeholder}]
  content     String   @db.Text // Template body with {{placeholders}}
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  correspondences Correspondence[]

  @@index([category])
  @@index([isActive])
}

model Correspondence {
  id               String    @id @default(cuid())
  title            String
  templateId       String
  template         Template  @relation(fields: [templateId], references: [id])
  fieldValues      Json      // Filled values {fieldName: value}
  renderedContent  String?   @db.Text // Final rendered content with placeholders replaced
  uploadedFileUrl  String?   // Path to uploaded correspondence file
  uploadedFileName String?
  status           String    @default("draft") // draft | submitted | approved | rejected
  adminNotes       String?   @db.Text
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([templateId])
  @@index([createdAt])
}
